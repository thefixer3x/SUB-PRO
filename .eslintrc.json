{
  "root": true,
  "ignorePatterns": ["docs/", "coverage/", "dist/", "android/", "ios/"],
  "extends": ["expo"],
  "rules": {
    "no-console": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "react-hooks/exhaustive-deps": "off",
    "react/display-name": "off",
    "@typescript-eslint/no-require-imports": "off",
    "@typescript-eslint/no-empty-object-type": "off",
    "@typescript-eslint/no-wrapper-object-types": "off",
    "no-restricted-imports": ["error", {
      "patterns": [{
        "group": ["server/*", "services/database"],
        "message": "Import server/* or services/database only in netlify/functions/ or api/ (server-side). For client code, use the Supabase client directly via lib/supabase."
      }]
    }]
  }
}
