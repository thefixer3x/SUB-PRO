# Sentry Configuration
# Replace these with your actual Sentry DSN
# DSN format: https://{public_key}@o{org_id}.ingest.sentry.io/{project_id}
EXPO_PUBLIC_SENTRY_DSN=https://8da8a4e367ae465b7002e5c0a23fa9b1@o4509338886209536.ingest.us.sentry.io/4509503258034176
SENTRY_ORG_ID=4509338886209536
SENTRY_PROJECT_ID=4509503258034176

# Instructions for deriving SENTRY_ORG_ID and SENTRY_PROJECT_ID from DSN:
#   1. DSN: https://{public_key}@o{org_id}.ingest.sentry.io/{project_id}
#   2. The org ID is between "o" and ".ingest.sentry.io" in the hostname
#   3. The project ID is the path segment after the hostname
#   4. CSP report URI: https://o{SENTRY_ORG_ID}.ingest.sentry.io/api/{SENTRY_PROJECT_ID}/csp-report/
# See vercel.json and netlify.toml comments for the CSP configuration.

# Supabase Configuration
# Replace these with your actual Supabase project URL and anon key
# You can find these in your Supabase project dashboard under Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=your_actual_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_actual_supabase_anon_key_here

# Stripe Configuration
# Replace with your actual Stripe publishable key
# You can find this in your Stripe dashboard under Developers > API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_actual_stripe_publishable_key_here

# Logo Service Configuration (Optional)
# Get your free API token from https://logo.dev (21st.dev)
# This enables high-quality logo fetching for subscription brands
# If not provided, the app will fall back to Clearbit and Google Favicons
EXPO_PUBLIC_LOGO_DEV_TOKEN=your_logo_dev_token_here

# AdMob Configuration (Optional)
# Replace with your actual AdMob IDs or leave as is if not using AdMob
EXPO_PUBLIC_ADMOB_APP_ID=your_actual_admob_app_id_here
EXPO_PUBLIC_ADMOB_BANNER_ID=your_actual_admob_banner_id_here
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=your_actual_admob_interstitial_id_here
EXPO_PUBLIC_ADMOB_REWARDED_ID=your_actual_admob_rewarded_id_here

# Feature Flags
EXPO_PUBLIC_MONETIZATION_V1=true
EXPO_PUBLIC_EMBED_FINANCE_BETA=false
EXPO_PUBLIC_COMPLIANCE_CENTER=true
EXPO_PUBLIC_SECURITY_MONITORING=true
EXPO_PUBLIC_PARTNER_HUB=true
EXPO_PUBLIC_SOCIAL_V1=true

# Instructions:
# 1. Replace all placeholder values with your actual credentials
# 2. For local development, copy this file to .env.local and add your real credentials there
# 3. For production deployment, set these as environment variables in your hosting platform