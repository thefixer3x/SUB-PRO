# SubTrack Pro Environment Variables
# Copy this file to .env.local for local development and fill in real values.
# NEVER commit .env.local to version control.

# ─── Sentry (from https://sentry.io/) ───
# DSN: https://{public_key}@o{org_id}.ingest.sentry.io/{project_id}
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG_ID=your_sentry_org_id_here
SENTRY_PROJECT_ID=your_sentry_project_id_here

# Debug flags
EXPO_PUBLIC_SENTRY_DEBUG=false
EXPO_PUBLIC_SENTRY_ENABLED=false

# ─── Supabase (from https://supabase.com/) ───
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# ─── Stripe (from https://dashboard.stripe.com/) ───
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ─── Feature Flags ───
EXPO_PUBLIC_MONETIZATION_V1=true
EXPO_PUBLIC_EMBED_FINANCE_BETA=false
EXPO_PUBLIC_COMPLIANCE_CENTER=true
EXPO_PUBLIC_SECURITY_MONITORING=true
EXPO_PUBLIC_PARTNER_HUB=true
EXPO_PUBLIC_SOCIAL_V1=true

# ─── CORS ───
ALLOWED_ORIGINS=http://localhost:5000,https://sub-pro.lanonasis.com,https://subtrack-pro.lanonasis.com

# ─── AdMob (Optional) ───
EXPO_PUBLIC_ADMOB_APP_ID=your_admob_app_id_here
EXPO_PUBLIC_ADMOB_BANNER_ID=your_admob_banner_id_here
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=your_admob_interstitial_id_here
EXPO_PUBLIC_ADMOB_REWARDED_ID=your_admob_rewarded_id_here

# ─── Logo Service (Optional) ───
EXPO_PUBLIC_LOGO_DEV_TOKEN=your_logo_dev_token_here

# Instructions:
# 1. Copy to .env.local and fill in real values

# 2. Vercel sync (add new vars, then update existing ones):
#    vercel env add SENTRY_ORG_ID --value <value> --environment production,preview,development --type config --force --yes
#    vercel env add SENTRY_PROJECT_ID --value <value> --environment production,preview,development --type config --force --yes
#    vercel env update EXPO_PUBLIC_SENTRY_DSN --value <value> --environment production,preview,development --yes

# 3. Netlify: functions read their own environment — not Vercel's.
#    Add to Netlify site settings (Settings > Environment variables):
#    EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#    SUPABASE_SECRET_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET