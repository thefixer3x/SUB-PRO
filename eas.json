{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_NO_BUN": "1",
        "EXPO_PUBLIC_ADMOB_APP_ID": "ca-app-pub-3940256099942544~3347511713",
        "EXPO_PUBLIC_MONETIZATION_V1": "true",
        "EXPO_PUBLIC_EMBED_FINANCE_BETA": "true",
        "EXPO_PUBLIC_COMPLIANCE_CENTER": "true"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EAS_NO_BUN": "1",
        "EXPO_PUBLIC_ADMOB_APP_ID": "ca-app-pub-3940256099942544~3347511713",
        "EXPO_PUBLIC_MONETIZATION_V1": "true",
        "EXPO_PUBLIC_EMBED_FINANCE_BETA": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EAS_NO_BUN": "1",
        "EXPO_PUBLIC_ENABLE_MOCK_AUTH": "false",
        "EXPO_PUBLIC_MONETIZATION_V1": "true",
        "EXPO_PUBLIC_EMBED_FINANCE_BETA": "false",
        "EXPO_PUBLIC_COMPLIANCE_CENTER": "true",
        "EXPO_PUBLIC_SECURITY_MONITORING": "true",
        "EXPO_PUBLIC_PARTNER_HUB": "true",
        "EXPO_PUBLIC_SOCIAL_V1": "true"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "store-submission": {
      "environment": "production",
      "extends": "production",
      "channel": "production",
      "env": {
        "EAS_NO_BUN": "1",
        "EXPO_PUBLIC_ENABLE_MOCK_AUTH": "false",
        "EXPO_PUBLIC_EMBED_FINANCE_BETA": "true"
      },
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "changesNotSentForReview": false,
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6748663048",
        "appleTeamId": "5D9V25DXPB",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyIssuerId": "c63babaa-12b6-4399-b0ff-d5fd3a04f404",
        "ascApiKeyId": "2F2UYP8DDP"
      }
    },
    "store-submission": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production",
        "changesNotSentForReview": false,
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6748663048",
        "appleTeamId": "5D9V25DXPB",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyIssuerId": "c63babaa-12b6-4399-b0ff-d5fd3a04f404",
        "ascApiKeyId": "2F2UYP8DDP"
